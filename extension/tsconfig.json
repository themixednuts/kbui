{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["chrome", "vitest/globals"]
  },
  "include": [
    ".wxt/**/*.d.ts",
    "entrypoints/**/*.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    "test/**/*.ts",
    "../src/lib/typing-runs/contracts.ts",
    "wxt.config.ts",
    "vitest.config.ts"
  ]
}
